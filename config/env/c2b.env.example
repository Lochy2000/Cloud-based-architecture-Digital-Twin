# C2b — AWS IoT Core. 
# Mutual TLS, not username/password. Certificate paths are inside the
# container: mount them via the certs volume in docker-compose.yml.

BROKER_HOST=
BROKER_PORT=8883
BROKER_TLS=true
BROKER_AUTH_MODE=cert
BROKER_CA_CERT=/certs/AmazonRootCA1.pem
BROKER_CLIENT_CERT=/certs/device-certificate.pem.crt
BROKER_CLIENT_KEY=/certs/device-private.pem.key
BROKER_KEEPALIVE=60
MQTT_QOS=1

ASSET_ID=boiler_01
ASSET_CONFIG_PATH=/app/config/assets/boiler_01.yaml
PUBLISH_INTERVAL_SECONDS=30

INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_ORG=digital-twin
INFLUX_BUCKET=telemetry
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

LOG_LEVEL=INFO