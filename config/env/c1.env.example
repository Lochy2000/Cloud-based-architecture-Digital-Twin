# C1 — self-hosted Mosquitto. 

BROKER_CA_CERT=/certs/ca.crt
BROKER_HOST=mosquitto
BROKER_PORT=8883
BROKER_TLS=true
BROKER_AUTH_MODE=password
BROKER_USERNAME=twin
BROKER_PASSWORD=replace-with-generated-password
BROKER_KEEPALIVE=60
MQTT_QOS=1

ASSET_ID=boiler_01
ASSET_CONFIG_PATH=/app/config/assets/boiler_01.yaml
PUBLISH_INTERVAL_SECONDS=30

INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_ORG=digital-twin
INFLUX_BUCKET=telemetry
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

LOG_LEVEL=INFO
